{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intubatalk",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intubatalk",
      "database_id": "25c16037-f55f-43d5-a4f8-114ef82a5fed"
    }
  ]
}
