{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intubatalk",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intubatalk",
      "database_id": "placeholder-local"
    }
  ]
}
